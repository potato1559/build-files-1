79956, 8.87500, -121.59781","Anchored":true},{"ShowShadow":true,"CanCollide":true,"Color":"0.2,0.2,0.2","Text":"Centerpiece, spiral stairs, kitchen, alarm system","Rotation":"0,-44.9969,0","Transparency":1,"Position":"-59.04236, 8.87501, -125.84030","Anchored":true},{"ShowShadow":true,"CanCollide":true,"Color":"0.2,0.2,0.2","Text":"CREDITS","Rotation":"0,-44.9969,0","Transparency":1,"Position":"-56.92090, 19.57500, -123.71912","Anchored":true},{"ShowShadow":true,"CanCollide":true,"Color":"0.2,0.2,0.2","Text":"EXTRAS 1","Rotation":"0,44.99687,0","Transparency":1,"Position":"-8.21295, 19.57500, -134.32510","Anchored":true},{"ShowShadow":true,"CanCollide":true,"Color":"0.2,0.2,0.2","Text":"Nearly half of all customers fall over the edge during their trip…","Rotation":"0,44.99687,0","Transparency":1,"Position":"-10.33441, 8.87501, -132.20395","Anchored":true},{"ShowShadow":true,"CanCollide":true,"Color":"0.2,0.2,0.2","Text":"There are over five hundred light bulbs","Rotation":"0,44.99687,0","Transparency":1,"Position":"-6.09149, 8.87500, -136.44629","Anchored":true},{"ShowShadow":true,"CanCollide":true,"Color":"0.2,0.2,0.2","Text":"This aircraft costed over two hundred thousand gold to build","Rotation":"0,44.99687,0","Transparency":1,"Position":"-10.33441, 13.87501, -132.20395","Anchored":true},{"ShowShadow":true,"CanCollide":true,"Color":"0.2,0.2,0.2","Text":"Propulsion system funded by Matthaw1711","Rotation":"0,44.99687,0","Transparency":1,"Position":"-6.09161, 13.87500, -136.44644","Anchored":true}],"GoldBlock":[{"ShowShadow":true,"CanCollide":true,"Color":"0.458824,0,0","Anchored":true,"Rotation":"0,-29.99161,0","Transparency":0,"Position":"5.73819, 43.89997, 44.21613","Size":"2.00000, 0.20000, 2.00000"},{"ShowShadow":true,"CanCollide":true,"Color":"0.458824,0,0","Anchored":true,"Rotation":"-180.00001,45.00222,-180.00001","Transparency":0,"Position":"29.82001, 43.89997, 30.34268","Size":"2.00000, 0.20000, 2.00000"},{"ShowShadow":true,"CanCollide":true,"Color":"0.4